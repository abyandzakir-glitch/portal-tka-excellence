# Salin menjadi .env.local lalu isi nilainya. Jangan pernah commit .env.local.
# Semua nilai Supabase ada di: Supabase Dashboard → Project Settings.

# --- Supabase (Project Settings → API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Publishable key (sb_publishable_...). Aman untuk browser; RLS tetap berlaku.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). HANYA server: dipakai untuk mengundang pengguna & seed.
SUPABASE_SECRET_KEY=

# --- Database (Connect → Connection string) ---
# Pooler, transaction mode (port 6543) — dipakai aplikasi saat runtime.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Koneksi langsung / session mode (port 5432) — dipakai migrasi, seed, dan test RLS.
DATABASE_URL_DIRECT=postgresql://postgres.xxxxxxxxxxxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# --- Seed data dummy ---
# Kata sandi untuk akun demo (min. 10 karakter). Kosongkan untuk dibuatkan acak.
SEED_DEMO_PASSWORD=

# --- Anthropic Claude API (Fase 4, ekstraksi AI; server-side saja) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
